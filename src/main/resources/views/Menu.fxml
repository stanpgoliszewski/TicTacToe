<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="276.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tictactoe.gui.controller.MenuController">
   <children>
      <VBox layoutY="-3.0" prefHeight="420.0" prefWidth="277.0" style="-fx-background-color: #5430AA;">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #5430AA;">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="TIC TAC TOE" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="47.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #5430AA;">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Select gamemode:" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="60.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #5430AA;">
               <children>
                  <Button fx:id="btnMultiplayer" mnemonicParsing="false" onAction="#handleGameMode" prefHeight="11.0" prefWidth="272.0" text="MULTIPLAYER">
                     <HBox.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                     <font>
                        <Font name="Tahoma Bold" size="24.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox layoutY="10.0" prefHeight="100.0" prefWidth="277.0">
         <children>
            <Button fx:id="btnSingleplayer" mnemonicParsing="false" onAction="#handleGameMode" prefHeight="65.0" prefWidth="306.0" text="SINGLEPLAYER">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" top="120.0" />
               </HBox.margin>
               <font>
                  <Font name="Tahoma Bold" size="24.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
